#!/bin/sh -e
cmd="${0##*/}"
arg="$1"
[ $# -gt 0 ] && shift
case "$arg" in
/*) ACMEVIMDIR="$arg" ;;
?*) ACMEVIMDIR="$ACMEVIMDIR/$arg" ;;
esac
[ -d "$ACMEVIMDIR" ] || ACMEVIMDIR="$(dirname "$ACMEVIMDIR")"
cd -- "$ACMEVIMDIR"
case "$cmd" in
Dir)
	[ -z "$arg" -a "$ACMEVIMFILE" = . ] && exec fned
	[ -n "$arg" -o "$ACMEVIMFILE" = guide ] && ACMEVIMFILE=''
	[ -n "$ACMEVIMFILE" ] && avim -l '\<' "${ACMEVIMFILE%.*}" '\>'
	exec avim -o . ;;
Pty)
	exec avim -t "$@" ;;
*)
	exec avim -s "$(echo "a$cmd" | tr '[[:upper:]]' '[[:lower:]]')" "$@" ;;
esac
